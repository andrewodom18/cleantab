{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    ".wxt/**/*.d.ts",
    "entrypoints/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
